import { VerticalBox, HorizontalBox, Button, Slider, ScrollView } from "std-widgets.slint";
import "./assets/remixicon.ttf";

global Ri {
    out property <string> folder-open: "\u{ed70}";
    out property <string> folder-add: "\u{ed5a}";
    out property <string> scissors: "\u{f0c1}";
    out property <string> captions: "\u{eb9b}";
    out property <string> file-sub: "\u{ed0f}";
    out property <string> tab-chapter: "\u{ecef}";
    out property <string> tab-media: "\u{ed54}";
    out property <string> lock: "\u{eecd}";
    out property <string> tools: "\u{f21b}";
    out property <string> headphone: "\u{ee05}";
    out property <string> split: "\u{f17a}";
    out property <string> merge: "\u{ef41}";
    out property <string> music: "\u{ef83}";
    out property <string> play: "\u{f00a}";
    out property <string> pause: "\u{efd7}";
    out property <string> skip-back: "\u{f13f}";
    out property <string> skip-forward: "\u{f143}";
    out property <string> speed: "\u{f177}";
    out property <string> repeat: "\u{f072}";
    out property <string> repeat-one: "\u{f076}";
    out property <string> pause-circle: "\u{efd6}";
    out property <string> play-circle: "\u{f009}";
    out property <string> add: "\u{ea13}";
    out property <string> subtract: "\u{f1af}";
    out property <string> check: "\u{eb7b}";
    out property <string> time: "\u{f20f}";
    out property <string> volume: "\u{f2a2}";
    out property <string> eye: "\u{ecb5}";
    out property <string> eye-off: "\u{ecb7}";
    out property <string> arrow-down-s: "\u{ea4e}";
    out property <string> arrow-right-s: "\u{ea6e}";
    out property <string> close: "\u{eb99}";
    out property <string> download: "\u{ec5a}";
    out property <string> info: "\u{ee59}";
    out property <string> github: "\u{edca}";
    out property <string> external-link: "\u{ecaf}";
}

component RiButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <color> icon-color: root.primary ? #ffffff : #334155;
    in property <length> icon-size: 15px;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> btn-height: 32px;
    callback clicked();

    border-radius: 6px;
    background: !root.enabled ? #f8fafc : (touch.pressed ? (root.primary ? #1d4ed8 : #e2e8f0) : (touch.has-hover ? (root.primary ? #2563eb : #f1f5f9) : (root.primary ? #3b82f6 : #ffffff)));
    border-width: root.primary ? 0px : 1px;
    border-color: root.primary ? transparent : (touch.has-hover ? #94a3b8 : #cbd5e1);
    height: root.btn-height;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        alignment: center;

        if root.icon != "" : Text {
            font-family: "remixicon";
            text: root.icon;
            color: !root.enabled ? #94a3b8 : (root.primary ? #ffffff : root.icon-color);
            font-size: root.icon-size;
            vertical-alignment: center;
        }

        if root.text != "" : Text {
            text: root.text;
            color: !root.enabled ? #94a3b8 : (root.primary ? #ffffff : #1e293b);
            font-size: 12px;
            font-weight: root.primary ? 600 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component RiIcon inherits Text {
    in property <string> icon: "";
    in property <color> icon-color: #334155;
    in property <length> icon-size: 16px;

    font-family: "remixicon";
    text: root.icon;
    color: root.icon-color;
    font-size: root.icon-size;
    vertical-alignment: center;
    horizontal-alignment: center;
}

export struct MediaRow {
    id: int,
    title: string,
    duration-str: string,
    progress-ratio: float, // 0.0 - 1.0
    is-analyzed: bool,
}

export struct ChapterRow {
    chapter-index: int, // 在规范章节列表中的下标（可见行是它的子集，回调必须用它）
    title: string,
    time-range: string,
    level: int,        // 0 = 材料, 1 = 题
    sub-count: int,    // 材料下的题数（题行为 0）
    confidence: float,
    low-confidence: bool,
    locked: bool,
    collapsed: bool,   // 材料行：已折叠（题行恒 false）
}

export struct WordCell {
    text: string,
    start-ms: int,
    idx: int,          // 在整句里的序号（点击跳转用）
}

export struct WhisperBuildRow {
    id: string,
    name: string,
    desc: string,
    size-str: string,
    installed: bool,
    downloading: bool,
    download-progress: float,
    download-status: string,
}

export struct ModelBenchmarkRow {
    spec: string,
    name: string,
    filename: string,
    desc: string,
    installed: bool,
    file-size: string,
    downloading: bool,
    download-progress: float,
    download-status: string,
    bench-status: string,
    is-recommended: bool,
}

export component MainWindow inherits Window {
    in-out property <string> app-title: "limelisten — 听力播放器";
    title: root.app-title;
    // 窗口/任务栏图标（Windows 下即 WM_SETICON + taskbar icon）。
    // exe 自身的图标（资源管理器、快捷方式看得见）由 assets/limelisten.rc 嵌入，见 build.rs。
    icon: @image-url("assets/logo.png");
    preferred-width: 1320px;
    preferred-height: 860px;
    min-width: 1000px;
    min-height: 700px;
    background: #f1f5f9;

    // ---- 数据模型 ----
    in-out property <[MediaRow]> media-list: [];
    in-out property <int> current-media-idx: -1;
    in-out property <int> sidebar-tab: 0; // 0 = 章节导航, 1 = 媒体库
    in-out property <[ChapterRow]> chapters: [];
    in-out property <int> chapter-total: 0;
    in-out property <[[WordCell]]> lines: [];
    in-out property <int> current: -1;
    in-out property <int> active-word: -1;
    in-out property <string> status: "就绪";
    in-out property <string> info: "1.00x";
    in-out property <string> time-display: "00:00 / 00:00";
    in-out property <string> next-line: "";
    in-out property <float> position: 0;
    in-out property <float> duration: 1;
    in-out property <bool> playing: false;
    in-out property <int> loop-count: 0;
    in-out property <bool> auto-pause: true;
    in-out property <float> transcribe-progress: -1;   // <0 = 未在转写
    in-out property <bool> has-subtitles: false;
    // 听力原文（逐词字幕）是否可见：关掉即「盲听模式」，NEXT 预览也一起遮蔽
    in-out property <bool> show-transcript: true;
    in-out property <bool> has-chapters: false;
    in-out property <string> chime-info: "";
    in-out property <string> underruns: "";
    in-out property <string> current-track-title: "未选择音频";

    // ---- 测速与模型模态框 ----
    in-out property <bool> show-bench-modal: false;
    in-out property <[ModelBenchmarkRow]> bench-models: [];
    in-out property <bool> is-benchmarking: false;
    in-out property <string> bench-summary: "";

    // ---- 转写引擎（whisper-cli） ----
    in-out property <bool> whisper-installed: false;
    in-out property <string> whisper-status: "";
    in-out property <[WhisperBuildRow]> whisper-builds: [];

    // ---- 关于模态框 ----
    in-out property <bool> show-about-modal: false;
    in-out property <string> app-version: "0.1.0";
    in-out property <string> github-url: "https://github.com/zkz098/limelisten";
    in-out property <string> license-name: "GPL-3.0-or-later";

    // ---- 回调命令 ----
    callback open-file();
    callback open-folder();
    callback select-media(int);
    callback select-tab(int);
    callback analyze();
    callback transcribe();
    callback save-limed();
    callback play-pause();
    callback prev-chapter();
    callback next-chapter();
    callback select-chapter(int);
    callback seek-to(float);
    callback speed-up();
    callback speed-down();
    callback loop-cycle();
    callback toggle-auto-pause();
    callback export-subtitles(string); // "srt", "lrc", "txt"
    callback click-word(int);
    callback toggle-transcript(); // 隐藏 / 显示听力原文

    // 测速与模型命令
    callback open-bench-modal();
    callback close-bench-modal();
    callback start-bench();
    callback download-model(string);
    callback download-whisper(string);

    // 关于与外部链接命令
    callback open-about-modal();
    callback close-about-modal();
    callback open-url(string);

    // 材料折叠 / 展开
    callback toggle-chapter-collapse(int);

    // 题级微调命令 (P1-3)
    callback adjust-chapter(float, bool); // (delta_seconds, is_start)
    callback split-current-chapter();
    callback merge-next-chapter();
    callback preview-boundary();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // ================= 顶部导航工具栏 =================
        Rectangle {
            height: 48px;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e2e8f0;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                // Logo：真图标 ui/assets/logo.png（取自项目根目录 logo.png，黑底已抠为透明底；
                // 正方形母版 256x256，图形本体上下各留 135/1215 的空白，故外面给 36x36 的盒子）
                // 这里的 HorizontalLayout 显式 horizontal-stretch: 0：整组只占内容宽度，
                // 剩余空间全部留给下面那个 horizontal-stretch: 1 的状态栏 spacer。
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 8px;
                    alignment: center;

                    Image {
                        source: @image-url("assets/logo.png");
                        width: 36px;
                        height: 36px;
                        image-fit: contain;
                    }

                    Text {
                        horizontal-stretch: 0;
                        text: "limelisten";
                        color: #0f172a;
                        font-size: 16px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: 1px; height: 24px; background: #e2e8f0; }

                RiButton {
                    icon: Ri.folder-open;
                    text: "打开文件…";
                    clicked => { root.open-file(); }
                }

                RiButton {
                    icon: Ri.folder-add;
                    text: "扫描文件夹…";
                    clicked => { root.open-folder(); }
                }

                Rectangle { width: 1px; height: 24px; background: #e2e8f0; }

                RiButton {
                    icon: Ri.scissors;
                    text: "切分";
                    clicked => { root.analyze(); }
                }

                RiButton {
                    icon: Ri.captions;
                    text: root.transcribe-progress >= 0 ? "转写中 (" + round(root.transcribe-progress * 100) + "%)" : "转写字幕";
                    primary: root.transcribe-progress >= 0;
                    clicked => { root.transcribe(); }
                }

                // 导出字幕与缓存菜单
                Rectangle { width: 1px; height: 24px; background: #e2e8f0; }

                RiButton {
                    icon: Ri.file-sub;
                    text: "保存 .limed";
                    enabled: root.has-chapters || root.has-subtitles;
                    clicked => { root.save-limed(); }
                }

                RiButton {
                    icon: Ri.file-sub;
                    text: "导出 SRT";
                    enabled: root.has-subtitles;
                    clicked => { root.export-subtitles("srt"); }
                }

                RiButton {
                    icon: Ri.file-sub;
                    text: "导出 LRC";
                    enabled: root.has-subtitles;
                    clicked => { root.export-subtitles("lrc"); }
                }

                RiButton {
                    icon: Ri.file-sub;
                    text: "导出 TXT";
                    enabled: root.has-subtitles;
                    clicked => { root.export-subtitles("txt"); }
                }

                Rectangle { width: 1px; height: 24px; background: #e2e8f0; }

                RiButton {
                    icon: Ri.speed;
                    text: "测速与模型";
                    clicked => { root.open-bench-modal(); }
                }

                RiButton {
                    icon: Ri.info;
                    text: "关于";
                    clicked => { root.open-about-modal(); }
                }

                // 状态文本
                Rectangle {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text {
                            text: root.status;
                            color: #475569;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ================= 主体工作区 =================
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // ---------------- 左侧栏（380px）：章节 / 媒体库 ----------------
            Rectangle {
                width: 380px;
                background: white;
                border-radius: 8px;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // 选项卡切换头
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;

                        Rectangle {
                            horizontal-stretch: 1;
                            background: root.sidebar-tab == 0 ? #e0e7ff : #f1f5f9;
                            border-radius: 6px;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                RiIcon {
                                    icon: Ri.tab-chapter;
                                    icon-size: 14px;
                                    icon-color: root.sidebar-tab == 0 ? #3730a3 : #64748b;
                                }
                                Text {
                                    text: root.chapters.length == root.chapter-total ? "章节 (" + root.chapter-total + ")" : "章节 (" + root.chapters.length + "/" + root.chapter-total + ")";
                                    color: root.sidebar-tab == 0 ? #3730a3 : #64748b;
                                    font-size: 13px;
                                    font-weight: root.sidebar-tab == 0 ? 700 : 500;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.sidebar-tab = 0; } }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: root.sidebar-tab == 1 ? #e0e7ff : #f1f5f9;
                            border-radius: 6px;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                RiIcon {
                                    icon: Ri.tab-media;
                                    icon-size: 14px;
                                    icon-color: root.sidebar-tab == 1 ? #3730a3 : #64748b;
                                }
                                Text {
                                    text: "媒体库 (" + root.media-list.length + ")";
                                    color: root.sidebar-tab == 1 ? #3730a3 : #64748b;
                                    font-size: 13px;
                                    font-weight: root.sidebar-tab == 1 ? 700 : 500;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.sidebar-tab = 1; } }
                        }
                    }

                    // 信息指示
                    if root.sidebar-tab == 0 : Text {
                        text: root.chime-info;
                        color: #94a3b8;
                        font-size: 11px;
                        height: 14px;
                        overflow: elide;
                    }

                    // TAB 0: 章节列表
                    if root.sidebar-tab == 0 : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;

                        // 列表本体
                        ScrollView {
                            VerticalLayout {
                                width: parent.width;
                                spacing: 2px;
                                for row in root.chapters : Rectangle {
                                    height: row.level == 0 ? 34px : 28px;
                                    background: row.chapter-index == root.current ? #dbeafe : (row-touch.has-hover ? #f8fafc : transparent);
                                    border-radius: 5px;

                                    // 整行点击选中（声明在布局之前，让折叠箭头的 TouchArea 优先命中）
                                    row-touch := TouchArea { clicked => { root.select-chapter(row.chapter-index); } }

                                    // 题行的缩进导轨：一眼看出属于上面那份材料，
                                    // 顺序错乱时（题跑出材料外面）也能立刻发现。
                                    if row.level == 1 : Rectangle {
                                        x: 16px;
                                        y: 5px;
                                        width: 2px;
                                        height: parent.height - 10px;
                                        border-radius: 1px;
                                        background: row.chapter-index == root.current ? #60a5fa : #cbd5e1;
                                    }

                                    HorizontalLayout {
                                        width: 100%;
                                        padding-left: row.level == 0 ? 6px : 26px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        // 材料折叠箭头：首份材料（引言）默认折叠
                                        if row.level == 0 : Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: arrow-touch.has-hover ? #e2e8f0 : transparent;

                                            RiIcon {
                                                icon: row.collapsed ? Ri.arrow-right-s : Ri.arrow-down-s;
                                                icon-size: 14px;
                                                icon-color: #475569;
                                            }
                                            arrow-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-chapter-collapse(row.chapter-index); }
                                            }
                                        }

                                        // 锁标记
                                        if row.locked : RiIcon {
                                            icon: Ri.lock;
                                            icon-size: 12px;
                                            icon-color: #b45309;
                                        }

                                        // 材料图标
                                        if row.level == 0 : RiIcon {
                                            icon: Ri.tab-chapter;
                                            icon-size: 13px;
                                            icon-color: row.chapter-index == root.current ? #1d4ed8 : #4f46e5;
                                        }

                                        Text {
                                            text: row.title;
                                            color: row.low-confidence ? #b45309 : (row.level == 0 ? #0f172a : #334155);
                                            font-weight: row.level == 0 ? 700 : 400;
                                            font-size: row.level == 0 ? 13px : 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        // 材料下的题数：让两级层次一眼可读
                                        if row.sub-count > 0 : Rectangle {
                                            height: 16px;
                                            border-radius: 8px;
                                            background: #e0e7ff;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: center;
                                                Text {
                                                    text: row.sub-count + " 题";
                                                    color: #4338ca;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: row.time-range;
                                            color: #64748b;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                            }
                        }

                        // 章节微调工具卡片 (P1-3)
                        if root.current >= 0 : Rectangle {
                            height: 128px;
                            background: #f8fafc;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    RiIcon {
                                        icon: Ri.tools;
                                        icon-size: 13px;
                                        icon-color: #334155;
                                    }
                                    Text {
                                        text: "微调 (第 " + (root.current + 1) + " 项)";
                                        color: #334155;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                // 起点微调
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "起点:"; font-size: 11px; color: #64748b; vertical-alignment: center; width: 34px; }
                                    RiButton { text: "-0.5s"; btn-height: 24px; clicked => { root.adjust-chapter(-0.5, true); } }
                                    RiButton { text: "-0.1s"; btn-height: 24px; clicked => { root.adjust-chapter(-0.1, true); } }
                                    RiButton { text: "+0.1s"; btn-height: 24px; clicked => { root.adjust-chapter(0.1, true); } }
                                    RiButton { text: "+0.5s"; btn-height: 24px; clicked => { root.adjust-chapter(0.5, true); } }
                                }

                                // 终点微调
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "终点:"; font-size: 11px; color: #64748b; vertical-alignment: center; width: 34px; }
                                    RiButton { text: "-0.5s"; btn-height: 24px; clicked => { root.adjust-chapter(-0.5, false); } }
                                    RiButton { text: "-0.1s"; btn-height: 24px; clicked => { root.adjust-chapter(-0.1, false); } }
                                    RiButton { text: "+0.1s"; btn-height: 24px; clicked => { root.adjust-chapter(0.1, false); } }
                                    RiButton { text: "+0.5s"; btn-height: 24px; clicked => { root.adjust-chapter(0.5, false); } }
                                }

                                // 功能操作行
                                HorizontalLayout {
                                    spacing: 6px;
                                    RiButton {
                                        icon: Ri.headphone;
                                        text: "试听边界";
                                        btn-height: 28px;
                                        clicked => { root.preview-boundary(); }
                                    }
                                    RiButton {
                                        icon: Ri.split;
                                        text: "拆分";
                                        btn-height: 28px;
                                        clicked => { root.split-current-chapter(); }
                                    }
                                    RiButton {
                                        icon: Ri.merge;
                                        text: "合并下一节";
                                        btn-height: 28px;
                                        clicked => { root.merge-next-chapter(); }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 1: 媒体库列表
                    if root.sidebar-tab == 1 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: parent.width;
                            spacing: 4px;
                            for m[i] in root.media-list : Rectangle {
                                height: 48px;
                                background: i == root.current-media-idx ? #eff6ff : transparent;
                                border-radius: 6px;
                                border-width: i == root.current-media-idx ? 1px : 0px;
                                border-color: #bfdbfe;

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: m.title;
                                            color: #0f172a;
                                            font-size: 12px;
                                            font-weight: i == root.current-media-idx ? 700 : 500;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 3px;
                                            alignment: center;
                                            if m.is-analyzed : RiIcon {
                                                icon: Ri.check;
                                                icon-size: 11px;
                                                icon-color: #15803d;
                                            }
                                            Text {
                                                text: m.is-analyzed ? "已缓存" : "待切分";
                                                color: m.is-analyzed ? #15803d : #94a3b8;
                                                font-size: 10px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: m.duration-str;
                                            color: #64748b;
                                            font-size: 10px;
                                        }
                                        // 进度指示条
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 4px;
                                            background: #e2e8f0;
                                            border-radius: 2px;
                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * m.progress-ratio;
                                                height: 4px;
                                                background: #3b82f6;
                                                border-radius: 2px;
                                            }
                                        }
                                    }
                                }
                                TouchArea { clicked => { root.select-media(i); } }
                            }
                        }
                    }
                }
            }

            // ---------------- 右侧主区：逐词字幕舞台 + 播放控制 ----------------
            VerticalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                // 卡拉OK 逐词字幕展示区
                Rectangle {
                    vertical-stretch: 1;
                    background: white;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        // 当前曲目标题与提示
                        HorizontalLayout {
                            height: 24px;
                            spacing: 8px;
                            RiIcon {
                                icon: Ri.music;
                                icon-size: 15px;
                                icon-color: #64748b;
                            }
                            Text {
                                text: root.current-track-title;
                                color: #334155;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if !root.show-transcript : Text {
                                text: "原文已隐藏";
                                color: #b45309;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            // 隐藏 / 显示听力原文：练习时先自己听，需要对照再点开
                            RiButton {
                                icon: root.show-transcript ? Ri.eye-off : Ri.eye;
                                icon-size: 14px;
                                text: root.show-transcript ? "隐藏原文" : "显示原文";
                                btn-height: 24px;
                                clicked => { root.toggle-transcript(); }
                            }
                        }

                        Rectangle { height: 1px; background: #f1f5f9; }

                        // 逐词高亮主舞台（隐藏原文时换成占位卡片，一个字都不露）
                        if root.show-transcript : ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                for line in root.lines : HorizontalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    for w in line : Rectangle {
                                        background: w.idx == root.active-word ? #fef3c7 : transparent;
                                        border-color: w.idx == root.active-word ? #f59e0b : transparent;
                                        border-width: 1px;
                                        border-radius: 6px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 4px;
                                            padding-bottom: 4px;
                                            alignment: center;

                                            Text {
                                                text: w.text;
                                                color: w.idx == root.active-word ? #92400e : #1e293b;
                                                font-size: 20px;
                                                font-weight: w.idx == root.active-word ? 700 : 400;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.click-word(w.idx); }
                                        }
                                    }
                                }
                            }
                        }

                        if !root.show-transcript : Rectangle {
                            vertical-stretch: 1;
                            background: #f8fafc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;

                                RiIcon {
                                    icon: Ri.eye-off;
                                    icon-size: 40px;
                                    icon-color: #cbd5e1;
                                }

                                Text {
                                    text: "原文已隐藏";
                                    color: #334155;
                                    font-size: 16px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    RiButton {
                                        icon: Ri.eye;
                                        text: "显示原文";
                                        clicked => { root.toggle-transcript(); }
                                    }
                                }
                            }
                        }

                        // 下一句弱化预览
                        Rectangle {
                            height: 44px;
                            background: #f8fafc;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #f1f5f9;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                RiIcon {
                                    icon: Ri.play-circle;
                                    icon-size: 14px;
                                    icon-color: #94a3b8;
                                }
                                Text {
                                    text: "NEXT";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: (!root.has-subtitles || !root.show-transcript) ? "" : root.next-line;
                                    color: #64748b;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // 底部控制与进度卡片
                Rectangle {
                    height: 100px;
                    background: white;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;

                        // 进度滑块与时间
                        HorizontalLayout {
                            spacing: 12px;
                            height: 24px;
                            Text {
                                text: root.time-display;
                                color: #334155;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Slider {
                                horizontal-stretch: 1;
                                value: root.position;
                                minimum: 0;
                                maximum: max(root.duration, 1);
                                changed => { root.seek-to(self.value); }
                            }
                            Text {
                                text: root.underruns;
                                color: #94a3b8;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        // 按钮控制条
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            RiButton {
                                icon: Ri.skip-back;
                                text: "上一题";
                                clicked => { root.prev-chapter(); }
                            }

                            RiButton {
                                primary: true;
                                icon: root.playing ? Ri.pause : Ri.play;
                                text: root.playing ? "暂停" : "播放";
                                clicked => { root.play-pause(); }
                            }

                            RiButton {
                                icon: Ri.skip-forward;
                                text: "下一题";
                                clicked => { root.next-chapter(); }
                            }

                            Rectangle { width: 1px; height: 24px; background: #e2e8f0; }

                            RiButton {
                                icon: Ri.subtract;
                                text: "慢";
                                clicked => { root.speed-down(); }
                            }

                            Text {
                                text: root.info;
                                color: #1e293b;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            RiButton {
                                icon: Ri.add;
                                text: "快";
                                clicked => { root.speed-up(); }
                            }

                            Rectangle { width: 1px; height: 24px; background: #e2e8f0; }

                            RiButton {
                                icon: root.loop-count == 0 ? Ri.repeat : Ri.repeat-one;
                                text: root.loop-count == 0 ? "不循环" : "循环 " + root.loop-count + " 次";
                                clicked => { root.loop-cycle(); }
                            }

                            RiButton {
                                icon: root.auto-pause ? Ri.pause-circle : Ri.play-circle;
                                text: root.auto-pause ? "自动暂停: 开" : "自动暂停: 关";
                                clicked => { root.toggle-auto-pause(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ================= 测速与模型管理模态框 =================
    if root.show-bench-modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #0f172a66;

        TouchArea {
            // 拦截点击穿透
        }

        Rectangle {
            width: 760px;
            height: modal-content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #cbd5e1;
            clip: true;

            modal-content := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // 标题栏
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text {
                            text: "模型与转写测速";
                            font-size: 16px;
                            font-weight: 700;
                            color: #0f172a;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: close-touch.has-hover ? #f1f5f9 : transparent;
                        RiIcon {
                            icon: Ri.close;
                            icon-size: 16px;
                            icon-color: close-touch.has-hover ? #0f172a : #64748b;
                        }
                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-bench-modal(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: #f1f5f9; }

                // 转写引擎（whisper-cli.exe）：软件内一键下载
                Rectangle {
                    background: root.whisper-installed ? #f0fdf4 : #fff7ed;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.whisper-installed ? #bbf7d0 : #fed7aa;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;
                            RiIcon {
                                icon: root.whisper-installed ? Ri.check : Ri.tools;
                                icon-size: 16px;
                                icon-color: root.whisper-installed ? #16a34a : #ea580c;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "whisper-cli 转写引擎";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #0f172a;
                                }
                                Text {
                                    text: root.whisper-status;
                                    font-size: 11px;
                                    color: root.whisper-installed ? #15803d : #9a3412;
                                    overflow: elide;
                                }
                            }
                        }

                        for b in root.whisper-builds : Rectangle {
                            height: 34px;
                            background: #ffffff;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: b.installed ? #bbf7d0 : #e2e8f0;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: b.name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #1e293b;
                                    width: 110px;
                                }
                                Text {
                                    text: b.desc;
                                    font-size: 11px;
                                    color: #64748b;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: b.size-str;
                                    font-size: 11px;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }

                                if b.installed && !b.downloading : Rectangle {
                                    width: 74px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: #dcfce7;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        RiIcon { icon: Ri.check; icon-size: 12px; icon-color: #16a34a; }
                                        Text {
                                            text: "已就绪";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #16a34a;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if b.downloading : Rectangle {
                                    width: 230px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: #e0f2fe;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        Text {
                                            text: b.download-status;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #0284c7;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                if !b.installed && !b.downloading : RiButton {
                                    icon: Ri.download;
                                    text: "下载";
                                    btn-height: 24px;
                                    clicked => { root.download-whisper(b.id); }
                                }
                            }
                        }
                    }
                }

                // 模型列表
                VerticalLayout {
                    spacing: 8px;
                    for row in root.bench-models : Rectangle {
                        background: #f8fafc;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: row.is-recommended ? #86efac : #e2e8f0;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;

                                // 规格标签
                                Rectangle {
                                    width: 70px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: row.spec == "turbo" ? #ede9fe : (row.spec == "small" ? #e0e7ff : (row.spec == "base" ? #d1fae5 : #fef3c7));
                                    Text {
                                        text: row.name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: row.spec == "turbo" ? #6d28d9 : (row.spec == "small" ? #3730a3 : (row.spec == "base" ? #065f46 : #92400e));
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // 描述信息
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: row.desc;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #1e293b;
                                    }
                                    Text {
                                        text: row.filename + " · " + (row.installed ? ("已就绪 (" + row.file-size + ")") : ("未安装 (" + row.file-size + ")"));
                                        font-size: 11px;
                                        color: row.installed ? #16a34a : #64748b;
                                    }
                                }

                                // 测速徽章
                                Rectangle {
                                    width: 175px;
                                    height: 30px;
                                    border-radius: 6px;
                                    background: row.is-recommended ? #dcfce7 : #f1f5f9;
                                    border-width: 1px;
                                    border-color: row.is-recommended ? #bbf7d0 : #e2e8f0;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        spacing: 4px;
                                        if row.is-recommended : RiIcon {
                                            icon: Ri.check;
                                            icon-size: 13px;
                                            icon-color: #15803d;
                                        }
                                        Text {
                                            text: row.bench-status;
                                            font-size: 11px;
                                            font-weight: row.is-recommended ? 700 : 500;
                                            color: row.is-recommended ? #15803d : #334155;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 下载或就绪状态按钮
                                if !row.installed && !row.downloading : RiButton {
                                    text: "下载 (" + row.file-size + ")";
                                    icon: Ri.download;
                                    btn-height: 28px;
                                    clicked => { root.download-model(row.spec); }
                                }

                                if row.downloading : Rectangle {
                                    width: 130px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: #e0f2fe;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: row.download-status;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #0284c7;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if row.installed && !row.downloading : Rectangle {
                                    width: 80px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: #f1f5f9;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        RiIcon { icon: Ri.check; icon-size: 13px; icon-color: #16a34a; }
                                        Text {
                                            text: "已就绪";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #16a34a;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 下载进度条
                            if row.downloading : progress-bg := Rectangle {
                                height: 5px;
                                border-radius: 2px;
                                background: #e2e8f0;
                                Rectangle {
                                    x: 0;
                                    width: progress-bg.width * max(0.02, min(1.0, row.download-progress));
                                    height: 100%;
                                    border-radius: 2px;
                                    background: #0284c7;
                                }
                            }
                        }
                    }
                }

                // 底部总结与操作
                Rectangle { height: 1px; background: #e2e8f0; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.bench-summary;
                            font-size: 12px;
                            color: #334155;
                            font-weight: 500;
                        }
                    }

                    RiButton {
                        primary: true;
                        icon: Ri.play;
                        text: root.is-benchmarking ? "测速中..." : "开始测速";
                        enabled: !root.is-benchmarking;
                        clicked => { root.start-bench(); }
                    }

                    RiButton {
                        icon: Ri.close;
                        text: "关闭";
                        clicked => { root.close-bench-modal(); }
                    }
                }
            }
        }
    }

    // ================= 关于模态框 =================
    if root.show-about-modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #0f172a66;

        TouchArea {
            // 点击半透明背景关闭
            clicked => { root.close-about-modal(); }
        }

        Rectangle {
            width: 580px;
            height: about-modal-content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #cbd5e1;
            clip: true;

            TouchArea {
                // 拦截内部穿透点击
            }

            about-modal-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // 标题栏：Logo、软件名称、版本与关闭按钮
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    Image {
                        source: @image-url("assets/logo.png");
                        width: 48px;
                        height: 48px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                text: "limelisten";
                                font-size: 20px;
                                font-weight: 800;
                                color: #0f172a;
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: #dbeafe;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "v" + root.app-version;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #1d4ed8;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: "专为外语精听与听力训练打造的本地音频播放器";
                            font-size: 12px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: about-close-touch.has-hover ? #f1f5f9 : transparent;
                        RiIcon {
                            icon: Ri.close;
                            icon-size: 16px;
                            icon-color: about-close-touch.has-hover ? #0f172a : #64748b;
                        }
                        about-close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-about-modal(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: #f1f5f9; }

                // GitHub 仓库卡片
                Rectangle {
                    background: #f8fafc;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            RiIcon {
                                icon: Ri.github;
                                icon-size: 18px;
                                icon-color: #0f172a;
                            }

                            Text {
                                text: "GitHub 开源仓库";
                                font-size: 13px;
                                font-weight: 700;
                                color: #0f172a;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                background: #ffffff;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #cbd5e1;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.github-url;
                                        font-size: 12px;
                                        color: #2563eb;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            RiButton {
                                icon: Ri.external-link;
                                text: "访问仓库";
                                primary: true;
                                btn-height: 32px;
                                clicked => { root.open-url(root.github-url); }
                            }
                        }
                    }
                }

                // 开源协议卡片
                Rectangle {
                    background: #f8fafc;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            RiIcon {
                                icon: Ri.file-sub;
                                icon-size: 18px;
                                icon-color: #15803d;
                            }

                            Text {
                                text: "开源许可证";
                                font-size: 13px;
                                font-weight: 700;
                                color: #0f172a;
                            }

                            Rectangle {
                                border-radius: 4px;
                                background: #dcfce7;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: root.license-name;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #15803d;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: "GNU General Public License v3.0 or later (GPL-3.0-or-later)";
                            font-size: 12px;
                            font-weight: 600;
                            color: #334155;
                        }

                        Text {
                            text: "limelisten 是一款自由与开源软件（Free and Open Source Software）。根据 GNU GPL-3.0-or-later 协议：\n\n• 您可以自由运行、研究、修改与分发本软件；\n• 任何修改或基于本软件二次开发的作品必须同样以 GPL-3.0-or-later 协议开源并提供完整源代码；\n• 本软件按「原样」提供，没有任何明示或暗示的担保。";
                            font-size: 11px;
                            color: #64748b;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: end;
                            RiButton {
                                icon: Ri.external-link;
                                text: "查看 GPLv3 许可证正文";
                                btn-height: 28px;
                                clicked => { root.open-url("https://www.gnu.org/licenses/gpl-3.0.html"); }
                            }
                        }
                    }
                }

                // 底部说明与确定按钮
                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;

                    Text {
                        horizontal-stretch: 1;
                        text: "基于 Rust + Slint · 纯本地运行 · 保护隐私";
                        font-size: 11px;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }

                    RiButton {
                        text: "确定";
                        btn-height: 32px;
                        clicked => { root.close-about-modal(); }
                    }
                }
            }
        }
    }
}

